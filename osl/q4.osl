// Sort both arrays using bubble sort
var i := 0;
while (i < n - 1) {
    var j := 0;
    while (j < n - i - 1) {
        if (arr1[j] > arr1[j + 1]) {
            var temp := arr1[j];
            arr1[j] := arr1[j + 1];
            arr1[j + 1] := temp;
        }
        j := j + 1;
    }
    i := i + 1;
}

i := 0;
while (i < m - 1) {
    var j := 0;
    while (j < m - i - 1) {
        if (arr2[j] > arr2[j + 1]) {
            var temp := arr2[j];
            arr2[j] := arr2[j + 1];
            arr2[j + 1] := temp;
        }
        j := j + 1;
    }
    i := i + 1;
}

i:= 0;
var j:= 0;
var largest := -1;
while(i<n && j<m){
    if(arr1[i] = arr2[j]){
        largest := arr1[i];
        i := i + 1;
        j := j + 1;
    }
    else if(arr1[i] < arr2[j]){
        i := i + 1;
    }
    else{
        j := j + 1;
    }
}
logN largest;
